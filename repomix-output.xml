              { key: "shares", label: "Shares / Units", placeholder: "10" },
              { key: "avgCost", label: "Avg Cost Price", placeholder: "612.40" },
              { key: "brokerUrl", label: "Broker URL (optional)", placeholder: "https://www.hl.co.uk/..." },
