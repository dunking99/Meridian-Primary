function CalendarPage() {
  const [activeTab, setActiveTab] = useState("economic");
  const [filterImportance, setFilterImportance] = useState("all");
  const [filterType, setFilterType] = useState("all");
  const [expandedEvent, setExpandedEvent] = useState(null);
  const [countdown, setCountdown] = useState({});

  useEffect(() => {
    const tick = () => {
      const now = new Date();
      const newCounts = {};
      ECON_EVENTS_FULL.forEach((ev, i) => {
        if (ev.time === "—") return;
        const [h, m] = ev.time.split(":").map(Number);
        const evDate = new Date();
        evDate.setHours(h, m, 0, 0);
        if (evDate < now) evDate.setDate(evDate.getDate() + 1);
        const diff = evDate - now;
        const hrs = Math.floor(diff / 3600000);
        const mins = Math.floor((diff % 3600000) / 60000);
        const secs = Math.floor((diff % 60000) / 1000);
        newCounts[i] = hrs > 48 ? `${Math.floor(hrs / 24)}d ${hrs % 24}h` : `${hrs}h ${mins}m ${secs}s`;
      });
      setCountdown(newCounts);
    };
    tick();
    const t = setInterval(tick, 1000);
    return () => clearInterval(t);
  }, []);

  const filteredEvents = ECON_EVENTS_FULL.filter(ev => {
    if (filterImportance !== "all" && ev.importance !== filterImportance) return false;
    if (filterType !== "all" && ev.type !== filterType) return false;
    return true;
  });

  const groupedByDate = filteredEvents.reduce((acc, ev) => {
    const idx = ECON_EVENTS_FULL.indexOf(ev);
    if (!acc[ev.date]) acc[ev.date] = [];
    acc[ev.date].push({ ...ev, idx });
    return acc;
  }, {});

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
      <div style={{ display: "flex", gap: 2, borderBottom: "1px solid #1a1f2e" }}>
