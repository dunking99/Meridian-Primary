async function fetchAINewsSummary(story, setResult, setLoading) {
  setLoading(true);
  const prompt = `You are a buy-side analyst. News: "${story.headline}" (${story.source}). Market reaction: ${story.priceMove}, volume: ${story.volumeResponse}, sustained: ${story.sustained}.

Write exactly 3 labeled sentences:
WHAT HAPPENED: One sentence plain English summary.
WHY MARKETS CARE: The mechanism — why does this move prices?
ACTIONABLE OR NOISE: Is this a tradeable catalyst or background noise? Be explicit, give a reason.

Plain text only. No markdown.`;
  const { text } = await callAI(prompt, 400);
  setResult(text);
  setLoading(false);
}

