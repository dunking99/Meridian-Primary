                        <div style={{ fontSize: 11, color: "#7a8ba0" }}>
                          {ev.importance === "high" ? "HIGH IMPACT — Market-moving release. Expect elevated volatility. Consider reducing size in affected assets 30 minutes before." : "MEDIUM IMPACT — Monitor for deviation from consensus. Only significant beats/misses likely to move markets materially."}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      )}

      {activeTab === "earnings" && (
