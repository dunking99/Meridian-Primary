function applyDrift(price, symbol) {
  const v = { "^VIX": 0.004, "NG=F": 0.003, "CL=F": 0.002, "BZ=F": 0.002 }[symbol] || 0.0008;
  return +(price * (1 + (Math.random() - 0.5) * v)).toFixed(
    symbol.includes("=X") ? 4 : (symbol === "^TNX" || symbol === "^IRX") ? 3 : 2
  );
}

