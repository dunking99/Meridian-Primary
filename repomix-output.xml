          </div>

          <div style={{ padding: "8px 14px", background: "#ff475710", border: "1px solid #ff475730", borderRadius: 6, fontSize: 11, color: "#ff6b35" }}>
            ⚠ PORTFOLIO ALERT — You hold USD-sensitive assets (NVDA, META, TSLA, GLD, ISGLD). FOMC Mar 19 and PCE Mar 28 are direct catalysts. CPI Mar 12 sets the tone for both.
          </div>

          {Object.entries(groupedByDate).map(([date, events]) => (
            <div key={date}>
              <div style={{ fontSize: 11, fontWeight: 700, color: "#4a6080", fontFamily: "monospace", letterSpacing: 1, padding: "6px 2px", borderBottom: "1px solid #1a1f2e", marginBottom: 6 }}>{date}</div>
              {events.map(ev => {
