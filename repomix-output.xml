                      <div style={{ fontFamily: "monospace", fontSize: 10, color: "#ffa502", textAlign: "right" }}>{countdown[ev.idx] || ""}</div>
                    </div>
                    {isExp && (
                      <div style={{ background: "#080b12", borderRadius: "0 0 5px 5px", padding: "10px 12px", border: "1px solid #1a1f2e", borderTop: "none" }}>
